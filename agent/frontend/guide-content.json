  "steps": [
    {
      "id": 1,
      "title": "导览开场",
      "block": "home",
      "alpha": "calm",
      "xiaobei": "cheerful",
      "lines": [
        {
          "id": "s01-alpha-01",
          "role": "alpha",
          "text": "我们用一个示例认识这个应用。"
        },
        {
          "id": "s01-alpha-02",
          "role": "alpha",
          "text": "主页、建模、学习和工具会分别介绍。"
        },
        {
          "id": "s01-xiaobei-01",
          "role": "xiaobei",
          "text": "嗯嗯，我在后台准备了一个救护站选址的例子。"
        },
        {
          "id": "s01-xiaobei-02",
          "role": "xiaobei",
          "text": "导览分成六部分，每讲完一部分都会问你可以随时停下。"
        },
        {
          "id": "s01-xiaobei-03",
          "role": "xiaobei",
          "text": "这次用的是示例数据，不会改动你的项目，当然 也不消耗模型额度哦。"
        }
      ]
    },
    {
      "id": 2,
      "title": "项目主页",
      "block": "home",
      "alpha": "calm",
      "xiaobei": "cheerful",
      "lines": [
        {
          "id": "s02-alpha-01",
          "role": "alpha",
          "text": "这里是项目主页。"
        },
        {
          "id": "s02-alpha-02",
          "role": "alpha",
          "text": "新题目点击“新建项目”，已有项目从记录中打开。"
        },
        {
          "id": "s02-alpha-03",
          "role": "alpha",
          "text": "顶部可以切换不同模块。"
        },
        {
          "id": "s02-xiaobei-01",
          "role": "xiaobei",
          "text": "有题目就从新建项目开始，还没选题的话，去题库里说不定有惊喜。"
        },
        {
          "id": "s02-xiaobei-02",
          "role": "xiaobei",
          "text": "遇到不熟悉的方法，学习页面里大概路有答案。"
        },
        {
          "id": "s02-xiaobei-03",
          "role": "xiaobei",
          "text": "上次做了一半的题目，可以从原项目随时继续，讨论记录都会保存。"
        }
      ]
    },
    {
      "id": 3,
      "title": "新建项目",
      "block": "modeling",
      "alpha": "calm",
      "xiaobei": "curious",
      "lines": [
        {
          "id": "s03-alpha-01",
          "role": "alpha",
          "text": "在这里输入题目，或上传题目文件。"
        },
        {
          "id": "s03-alpha-02",
          "role": "alpha",
          "text": "下面填写初步想法，暂时没有也能开始。"
        },
        {
          "id": "s03-xiaobei-01",
          "role": "xiaobei",
          "text": "我们要给两个救护站选位置。"
        },
        {
          "id": "s03-xiaobei-02",
          "role": "xiaobei",
          "text": "我想到的是人口比较多的区域，那里需要服务的人也多。"
        },
        {
          "id": "s03-xiaobei-03",
          "role": "xiaobei",
          "text": "不过，距离远的地方能不能及时到达，还得算一算。"
        },
        {
          "id": "s03-xiaobei-04",
          "role": "xiaobei",
          "text": "像这样的初步想法就能写进去，就好了 嘿嘿。"
        }
      ]
    },
    {
      "id": 4,
      "title": "解题路线",
      "block": "modeling",
      "alpha": "analysis",
      "xiaobei": "cheerful",
      "lines": [
        {
          "id": "s04-alpha-01",
          "role": "alpha",
          "text": "这里列出当前题目的建模步骤。"
        },
        {
          "id": "s04-alpha-02",
          "role": "alpha",
          "text": "包括问题分析、假设、建模、求解和检验。"
        },
        {
          "id": "s04-alpha-03",
          "role": "alpha",
          "text": "需要核对条件时，点击这里查看题面。"
        },
        {
          "id": "s04-xiaobei-01",
          "role": "xiaobei",
          "text": "比如现在讨论的是选址条件，就把这一项说清楚，后面的计算有单独的步骤。"
        },
        {
          "id": "s04-xiaobei-02",
          "role": "xiaobei",
          "text": "什么 你说八分钟的要求记不清了？真拿你没办法，题面就在旁边，可以随时打开核对。"
        }
      ]
    },
    {
      "id": 5,
      "title": "讨论思路",
      "block": "modeling",
      "alpha": "analysis",
      "xiaobei": "curious",
      "lines": [
        {
          "id": "s05-alpha-01",
          "role": "alpha",
          "text": "在讨论区写下判断、疑问和依据。"
        },
        {
          "id": "s05-alpha-02",
          "role": "alpha",
          "text": "讨论完成后，可以整理成当前步骤的草稿。"
        },
        {
          "id": "s05-xiaobei-01",
          "role": "xiaobei",
          "text": "我想问：只选人口最多的两个区域，合适吗？"
        },
        {
          "id": "s05-xiaobei-02",
          "role": "xiaobei",
          "text": "距离远的区域会不会超过八分钟？"
        },
        {
          "id": "s05-xiaobei-03",
          "role": "xiaobei",
          "text": "你也可以直接这样问，不用客气，把自己不确定的地方说清楚就行。"
        }
      ]
    },
    {
      "id": 6,
      "title": "计算与验证",
      "block": "modeling",
      "alpha": "analysis",
      "xiaobei": "cheerful",
      "lines": [
        {
          "id": "s06-alpha-01",
          "role": "alpha",
          "text": "“计算与验证”用于检查当前方案。"
        },
        {
          "id": "s06-alpha-02",
          "role": "alpha",
          "text": "这里记录计算结果、图表和推导过程，也能补充外部结果。"
        },
        {
          "id": "s06-xiaobei-01",
          "role": "xiaobei",
          "text": "你在表格里算过的结果，或者纸上写的推导，都可以补充进来。"
        },
        {
          "id": "s06-xiaobei-02",
          "role": "xiaobei",
          "text": "哦对，别忘了写用的哪些数据、得到了什么结论，回头检查时用得上。"
        }
      ]
    },
    {
      "id": 7,
      "title": "代码与终端",
      "block": "modeling",
      "alpha": "analysis",
      "xiaobei": "cheerful",
      "lines": [
        {
          "id": "s07-alpha-01",
          "role": "alpha",
          "text": "需要编程时，在这里编辑并运行代码。"
        },
        {
          "id": "s07-alpha-02",
          "role": "alpha",
          "text": "结果面板和终端可以切换查看，运行中的程序可以停止。"
        },
        {
          "id": "s07-alpha-03",
          "role": "alpha",
          "text": "本次示例只查看已有输出。"
        },
        {
          "id": "s07-xiaobei-01",
          "role": "xiaobei",
          "text": "这份示例已经有输出了，导览里不用实际运行。"
        },
        {
          "id": "s07-xiaobei-02",
          "role": "xiaobei",
          "text": "自己写代码时，报错和运行信息到终端看，生成的结果也会在面板出现哦。"
        }
      ]
    },
    {
      "id": 8,
      "title": "读懂验证结果",
      "block": "modeling",
      "alpha": "warning",
      "xiaobei": "curious",
      "lines": [
        {
          "id": "s08-alpha-01",
          "role": "alpha",
          "text": "A 加 B 的最长用时是十二分钟，超过八分钟的要求。"
        },
        {
          "id": "s08-alpha-02",
          "role": "alpha",
          "text": "A 加 C 的最长用时是七分钟，满足要求。"
        },
        {
          "id": "s08-alpha-03",
          "role": "alpha",
          "text": "判断方案是否可用，要核对结果与题目条件。"
        },
        {
          "id": "s08-xiaobei-01",
          "role": "xiaobei",
          "text": "原来 A 加 B 要十二分钟，比要求多了四分钟。"
        },
        {
          "id": "s08-xiaobei-02",
          "role": "xiaobei",
          "text": "那我刚才只看人口的想法。哎呀，确实漏掉了路程时间。"
        },
        {
          "id": "s08-xiaobei-03",
          "role": "xiaobei",
          "text": "这次比较里，A 加 C 符合条件，这个计算结果也要记下来。"
        }
      ]
    },
    {
      "id": 9,
      "title": "本步成果",
      "block": "modeling",
      "alpha": "approval",
      "xiaobei": "cheerful",
      "lines": [
        {
          "id": "s09-alpha-01",
          "role": "alpha",
          "text": "把选择、理由、数据和限制写清楚。"
        },
        {
          "id": "s09-alpha-02",
          "role": "alpha",
          "text": "点击确认后，这一步才会成为项目记录。"
        },
        {
          "id": "s09-xiaobei-01",
          "role": "xiaobei",
          "text": "这次可以写：选择 A 加 C，最长用时七分钟。"
        },
        {
          "id": "s09-xiaobei-02",
          "role": "xiaobei",
          "text": "依据是哪次计算、哪些条件还没验证，也一起记下来。"
        },
        {
          "id": "s09-xiaobei-03",
          "role": "xiaobei",
          "text": "以后写论文，就能查到当时为什么这样选，嘿嘿，是不是很方便。"
        }
      ]
    },
    {
      "id": 10,
      "title": "版本与下一步",
      "block": "modeling",
      "alpha": "warning",
      "xiaobei": "cheerful",
      "lines": [
        {
          "id": "s10-alpha-01",
          "role": "alpha",
          "text": "历史版本可以回看，修改前面的决定可能使后续成果需要重新确认。"
        },
        {
          "id": "s10-alpha-02",
          "role": "alpha",
          "text": "所有步骤确认后，才能整理成论文材料。"
        },
        {
          "id": "s10-xiaobei-01",
          "role": "xiaobei",
          "text": "假设变动后，相关计算要记得重新看一遍。"
        },
        {
          "id": "s10-xiaobei-02",
          "role": "xiaobei",
          "text": "版本记录会把每次变化保留下来的 放心吧。"
        }
      ]
    },
    {
      "id": 11,
      "title": "论文大纲",
      "block": "paper",
      "alpha": "analysis",
      "xiaobei": "cheerful",
      "lines": [
        {
          "id": "s11-alpha-01",
          "role": "alpha",
          "text": "这里根据项目记录整理论文结构。"
        },
        {
          "id": "s11-alpha-02",
          "role": "alpha",
          "text": "每个章节都要对应实际完成的研究内容。"
        },
        {
          "id": "s11-xiaobei-01",
          "role": "xiaobei",
          "text": "刚才选 A 加 C 的理由，就应该出现在对应的章节里。"
        },
        {
          "id": "s11-xiaobei-02",
          "role": "xiaobei",
          "text": "当然，这里也能看到采用的研究材料，看看有没有遗漏需要解释的计算。"
        }
      ]
    },
    {
      "id": 12,
      "title": "调整大纲",
      "block": "paper",
      "alpha": "calm",
      "xiaobei": "curious",
      "lines": [
        {
          "id": "s12-alpha-01",
          "role": "alpha",
          "text": "局部内容使用“微调”，章节方向变化使用“重写本章”。"
        },
        {
          "id": "s12-alpha-02",
          "role": "alpha",
          "text": "公式、引用和版本记录都可以在这里核对。"
        },
        {
          "id": "s12-xiaobei-01",
          "role": "xiaobei",
          "text": "比如想补上两个方案的对比，可以在微调里把要求写具体哦。"
        },
        {
          "id": "s12-xiaobei-02",
          "role": "xiaobei",
          "text": "改完觉得上一版更合适，也可以打开版本记录对照。"
        }
      ]
    },
    {
      "id": 13,
      "title": "生成过程",
      "block": "paper",
      "alpha": "analysis",
      "xiaobei": "cheerful",
      "lines": [
        {
          "id": "s13-alpha-01",
          "role": "alpha",
          "text": "确认大纲后生成正文。"
        },
        {
          "id": "s13-alpha-02",
          "role": "alpha",
          "text": "页面会显示每章状态，未完成的章节可以继续处理。"
        },
        {
          "id": "s13-xiaobei-01",
          "role": "xiaobei",
          "text": "已经生成的章节可以打开读，等待其他章节时，随便检查一下内容吧。"
        }
      ]
    },
    {
      "id": 14,
      "title": "论文阅读与导出",
      "block": "paper",
      "alpha": "approval",
      "xiaobei": "excited",
      "lines": [
        {
          "id": "s14-alpha-01",
          "role": "alpha",
          "text": "通过目录检查正文和研究来源。"
        },
        {
          "id": "s14-alpha-02",
          "role": "alpha",
          "text": "确认图表、公式、结论一致后，可以导出 Word。"
        },
        {
          "id": "s14-xiaobei-01",
          "role": "xiaobei",
          "text": "现在能看到整篇论文了，我们看看选址结论写得怎么样。"
        },
        {
          "id": "s14-xiaobei-02",
          "role": "xiaobei",
          "text": "嗯嗯，表里写七分钟，正文里的数字也要一致，图表和公式都值得核对。"
        },
        {
          "id": "s14-xiaobei-03",
          "role": "xiaobei",
          "text": "导出的文件还能在 Word 里继续编辑。"
        }
      ]
    },
    {
      "id": 15,
      "title": "我的论文",
      "block": "paper",
      "alpha": "calm",
      "xiaobei": "cheerful",
      "lines": [
        {
          "id": "s15-alpha-01",
          "role": "alpha",
          "text": "已有论文在这里集中管理。"
        },
        {
          "id": "s15-alpha-02",
          "role": "alpha",
          "text": "按标题或状态查找文档，可以从上次的位置继续。"
        },
        {
          "id": "s15-xiaobei-01",
          "role": "xiaobei",
          "text": "忘了文档叫什么？没关系的，按状态筛选也能找，比如只看还在写的大纲。"
        },
        {
          "id": "s15-xiaobei-02",
          "role": "xiaobei",
          "text": "正文只生成了一部分的论文，也能从这里打开继续处理。"
        }
      ]
    },
    {
      "id": 16,
      "title": "学习页面",
      "block": "learning",
      "alpha": "calm",
      "xiaobei": "cheerful",
      "lines": [
        {
          "id": "s16-alpha-01",
          "role": "alpha",
          "text": "需要补充知识时，进入学习页面。"
        },
        {
          "id": "s16-alpha-02",
          "role": "alpha",
          "text": "可以按学习路径阅读，也可以按模块和难度查找。"
        },
        {
          "id": "s16-xiaobei-01",
          "role": "xiaobei",
          "text": "做题时遇到线性规划这样的陌生方法，可以直接搜名称。"
        },
        {
          "id": "s16-xiaobei-02",
          "role": "xiaobei",
          "text": "想从基础学起，就打开学习路径，看看我给你推荐的内容。"
        }
      ]
    },
    {
      "id": 17,
      "title": "知识阅读器",
      "block": "learning",
      "alpha": "analysis",
      "xiaobei": "curious",
      "lines": [
        {
          "id": "s17-alpha-01",
          "role": "alpha",
          "text": "阅读器会展示解释、例子、公式和应用。"
        },
        {
          "id": "s17-alpha-02",
          "role": "alpha",
          "text": "理解之后可以标记掌握，也可以围绕当前知识点提问。"
        },
        {
          "id": "s17-xiaobei-01",
          "role": "xiaobei",
          "text": "公式里的符号不熟悉时，结合例子看会容易理解一些。"
        },
        {
          "id": "s17-xiaobei-02",
          "role": "xiaobei",
          "text": "还有疑问的话，就带着当前知识点提问吧。"
        }
      ]
    },
    {
      "id": 18,
      "title": "测评入口与答题",
      "block": "learning",
      "alpha": "calm",
      "xiaobei": "cheerful",
      "lines": [
        {
          "id": "s18-alpha-01",
          "role": "alpha",
          "text": "测评用于了解当前水平，也可以自行选择等级。"
        },
        {
          "id": "s18-alpha-02",
          "role": "alpha",
          "text": "答题时可以返回上一题检查和修改。"
        },
        {
          "id": "s18-xiaobei-01",
          "role": "xiaobei",
          "text": "答题时发现前一道理解错了，可以返回修改。"
        }
      ]
    },
    {
      "id": 19,
      "title": "测评结果与路径",
      "block": "learning",
      "alpha": "approval",
      "xiaobei": "cheerful",
      "lines": [
        {
          "id": "s19-alpha-01",
          "role": "alpha",
          "text": "结果页会列出薄弱模块和推荐学习路径。"
        },
        {
          "id": "s19-alpha-02",
          "role": "alpha",
          "text": "这里可以查看答案解析，也能重新测评。"
        },
        {
          "id": "s19-xiaobei-01",
          "role": "xiaobei",
          "text": "我会建议你看看错题解析：是概念没理解，还是计算时出错了？"
        },
        {
          "id": "s19-xiaobei-02",
          "role": "xiaobei",
          "text": "推荐路径可以接着打开，补完相关内容后也能重新测一次。"
        }
      ]
    },
    {
      "id": 20,
      "title": "真题题库",
      "block": "practice",
      "alpha": "calm",
      "xiaobei": "excited",
      "lines": [
        {
          "id": "s20-alpha-01",
          "role": "alpha",
          "text": "这里提供完整赛题的分步练习。"
        },
        {
          "id": "s20-alpha-02",
          "role": "alpha",
          "text": "可以按题名、年份和难度查找，已开始的题目可以继续。"
        },
        {
          "id": "s20-xiaobei-01",
          "role": "xiaobei",
          "text": "想做真题的话，就在这里选。"
        },
        {
          "id": "s20-xiaobei-02",
          "role": "xiaobei",
          "text": "找到感兴趣的题目，可以看一下难度和要求。"
        },
        {
          "id": "s20-xiaobei-03",
          "role": "xiaobei",
